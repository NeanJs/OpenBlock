VITE_APP_NAME=CityFix
VITE_APP_TAGLINE=Report and track civic issues in your city.

# OpenFreeMap style id: liberty | bright | positron | dark | fiord | 3d
VITE_MAP_STYLE=liberty
# Optional override for a custom or self-hosted MapLibre style JSON URL
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_MAP_DEFAULT_LAT=49.2827
VITE_MAP_DEFAULT_LNG=-123.1207
VITE_MAP_DEFAULT_ZOOM=12

# Public API origin, no trailing slash. Used for POST /api/reports, POST /api/reports/transcribe, GET /api/reports/track/:trackingId, and GET /api/voice/conversations/:conversationId/issue.
# Leave empty until the backend is available; filing then stays on this device.
VITE_API_BASE_URL=
# Optional full URL override for the photo and text analysis step. Defaults to {VITE_API_BASE_URL}/api/reports/analyze
# VITE_REPORT_INGEST_URL=

# Supabase project URL and publishable key for client sign-in. Leave empty until configured.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public ElevenLabs Conversational Agent id for the voice-only screen.
VITE_ELEVENLABS_AGENT_ID=agent_7101k5zvyjhmfg983brhmhkd98n6

# Enable full offline/demo mode with mock data (no backend required).
# When true, the app runs entirely client-side with simulated API responses.
VITE_DEMO_MODE=false
